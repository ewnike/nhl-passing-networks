# Licensed third party data must never be committed or redistributed.
# See DATA_ACCESS.md. Only .gitkeep files and manifests are tracked.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/

# OS and editor
.DS_Store
.idea/
.vscode/

# Local credentials (none are needed for StatsBomb open data)
.env

# Row level derived tables (one row per possession or per team match) stay local,
# because they come close to reproducing the licensed data. Aggregates are committed.
outputs/tables/eda_possession_summary.csv
outputs/tables/eda_team_match_summary.csv

# Synthetic sample outputs (regenerated by `make sample`)
sample_data/raw/
sample_data/interim/
sample_data/processed/
sample_data/outputs/
sample_data/manifests/

# Explorer data holds match level rows derived from licensed data: local use only.
app/data.js
app/data_*.js
